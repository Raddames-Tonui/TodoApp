# MULTI STAGE BUILD FOR PRODUCTION

# 1. ---- Base Image (Build Stage) ----
    FROM node:18-alpine AS builder

    WORKDIR /app
    
    # Copy package.json and package-lock.json first
    COPY package*.json ./
    
    # Install dependencies in production mode (reduces image size)
    RUN npm install
    
    # Copy the rest of the application
    COPY . .
    
    # Build the static files
    RUN npm run build

# 2. ---- Production Image (Nginx) ----
    FROM nginx:alpine
    
    # Copy built files from builder stage to Nginx's serving directory
    COPY --from=builder /app/dist /usr/share/nginx/html
    
    # Expose port 80 for serving the app
    EXPOSE 80
    
    # Set up Nginx to handle React routing (SPA)
    COPY nginx.conf /etc/nginx/conf.d/default.conf
    
    # Start Nginx
    CMD ["nginx", "-g", "daemon off;"]
    